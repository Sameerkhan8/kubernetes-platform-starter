      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(http_requests_total{job=\"sample-api\",namespace=\"$namespace\"}[1m]))",
          "legendFormat": "{{status}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
